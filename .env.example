# Remote API Base URL (optional)
# When set, the app connects to this backend via Axios (e.g. GET /bookings).
# When unset or empty, the app runs offline using the in-app fake server.
# EXPO_PUBLIC_API_URL=https://api.example.com

# Fake Server Behavior Mode (optional)
# Controls the in-app fake server when EXPO_PUBLIC_API_URL is unset.
# Options:
#   (unset) - Normal mode (4-row fixture: 3 valid bookings, 1 malformed row skipped)
#   empty   - Empty list (tests "No bookings" empty state)
#   error   - HTTP 500 error (tests "Could not load bookings" error state & retry button)
# EXPO_PUBLIC_BOOKINGS=
